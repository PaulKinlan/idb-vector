{
  "name": "idb-vector",
  "version": "0.2.0",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulKinlan/idb-vector"
  },
  "scripts": {
    "test": "node tests/browser.mjs",
    "start": "serve",
    "demo": "node tools/demo-server.mjs",
    "measure": "node tests/browser.mjs --measure",
    "real:prepare": "python3 -m venv .cache/vector-python && .cache/vector-python/bin/pip install -r tools/real-vector-requirements.txt && .cache/vector-python/bin/python tools/prepare-real-vectors.py glove",
    "real:embed": "node tools/embed-wikipedia.mjs --embed && .cache/vector-python/bin/python tools/prepare-real-vectors.py wiki",
    "real:measure": "node tests/real-vectors.mjs",
    "demo:wikipedia": "node tools/wiki-demo-server.mjs",
    "test:wikipedia": "node tests/wikipedia-demo.mjs",
    "test:packed": "node tests/packed-snapshot.mjs",
    "measure:packed": "node tests/packed-read.mjs"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Paul Kinlan",
    "email": "paul.kinlan@gmail.com",
    "url": "https://paul.kinlan.me/"
  },
  "devDependencies": {
    "serve": "^14.2.0"
  }
}
