{
  "name": "idb-vector",
  "version": "0.2.0",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulKinlan/idb-vector"
  },
  "scripts": {
    "test": "node tests/browser.mjs && node tests/validation.mjs && node tests/candidates.mjs && node tests/eligibility.mjs && node tests/snapshot-isolation.mjs && node tests/side-store.mjs && node tests/cdp-orphans.mjs && npm run test:demo-restore && npm run test:middle",
    "test:fast": "NODE_OPTIONS=\"$NODE_OPTIONS --import=./tests/support/fast-tier-guard.mjs\" node --test --test-concurrency=2 $(bash tools/unit-tier-suites.sh fast)",
    "test:middle": "node --test --test-concurrency=2 $(bash tools/unit-tier-suites.sh middle)",
    "start": "node tools/wiki-demo-server.mjs",
    "demo": "node tools/demo-server.mjs",
    "measure": "node tests/browser.mjs --measure",
    "real:prepare": "python3 -m venv .cache/vector-python && .cache/vector-python/bin/pip install -r tools/real-vector-requirements.txt && .cache/vector-python/bin/python tools/prepare-real-vectors.py glove",
    "real:embed": "node tools/embed-wikipedia.mjs --embed && .cache/vector-python/bin/python tools/prepare-real-vectors.py wiki",
    "real:measure": "node tests/real-vectors.mjs",
    "demo:wikipedia": "node tools/wiki-demo-server.mjs",
    "test:wikipedia": "node tests/wikipedia-demo.mjs",
    "test:demo-restore": "node tests/demo-restore-trust.mjs",
    "test:packed": "node tests/packed-snapshot.mjs",
    "test:compute": "node tests/compute.mjs",
    "test:validation": "node tests/validation.mjs",
    "test:candidates": "node tests/candidates.mjs",
    "test:eligibility": "node tests/eligibility.mjs",
    "test:isolation": "node tests/snapshot-isolation.mjs",
    "test:side-store": "node tests/side-store.mjs",
    "test:cdp": "node tests/cdp-orphans.mjs",
    "measure:candidates": "node tests/candidates.mjs --measure",
    "measure:packed": "node tests/packed-read.mjs",
    "measure:packed-snapshot": "node tests/packed-snapshot-stress.mjs",
    "build:research": "node tools/build-research.mjs",
    "test:research": "node tests/research.mjs"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Paul Kinlan",
    "email": "paul.kinlan@gmail.com",
    "url": "https://paul.kinlan.me/"
  },
  "devDependencies": {
    "marked": "17.0.4"
  }
}
